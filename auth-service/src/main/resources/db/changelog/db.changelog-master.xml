<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Activation de l'extension UUID PostgreSQL -->
    <changeSet id="0-extensions" author="clinitrak">
        <sql>CREATE EXTENSION IF NOT EXISTS "pgcrypto";</sql>
        <sql>CREATE EXTENSION IF NOT EXISTS "uuid-ossp";</sql>
    </changeSet>

    <!-- V1 : Schéma initial complet -->
    <include file="V1__init.sql" relativeToChangelogFile="true"/>

    <!-- V2 : Données initiales (rôles système + tenant de démo) -->
    <include file="V2__seed_data.sql" relativeToChangelogFile="true"/>

</databaseChangeLog>
