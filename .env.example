# ============================================================
# CliniTrak — Variables d'environnement (copier vers .env)
# ============================================================
# IMPORTANT : Ne jamais committer le fichier .env en git !
# ============================================================

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinitrak_auth
DB_USER=clinitrak
DB_PASSWORD=clinitrak_dev_change_me_in_prod

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO (stockage objets)
MINIO_ACCESS_KEY=clinitrak_minio
MINIO_SECRET_KEY=clinitrak_minio_secret_change_me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# JWT
# Générer avec : openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_ACCESS_EXPIRATION_MS=900000

# CORS
CORS_ORIGIN_1=http://localhost:4200

# Tenant
CLINITRAK_ROOT_DOMAIN=clinitrak.be

# Study Service
STUDY_DB_NAME=clinitrak_study

# Ethics Service
ETHICS_DB_NAME=clinitrak_ethics
STUDY_SERVICE_URL=http://clinitrak-study:8082

# CTC Service
CTC_DB_NAME=clinitrak_ctc

# Pharmacy Service
PHARMACY_DB_NAME=clinitrak_pharmacy
PHARMACY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
LOW_STOCK_THRESHOLD=10

# Mail (MailHog en dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# Exchange Service
EXCHANGE_DB_NAME=clinitrak_exchange
EXCHANGE_JWT_SECRET=changeme-exchange-secret-key-must-be-at-least-256-bits-long

# Admin Service
ADMIN_DB_NAME=clinitrak_admin

# Document Service
DOCUMENT_DB_NAME=clinitrak_document
MINIO_ACCESS_KEY=clinitrak_minio
MINIO_SECRET_KEY=clinitrak_minio_secret_change_me

# Notification Service
NOTIFICATION_DB_NAME=clinitrak_notification
# MAIL_HOST et MAIL_PORT déjà définis ci-dessus (section Mail)

# Batch Service
BATCH_DB_NAME=clinitrak_batch
NOTIFICATION_SERVICE_URL=http://localhost:8090
PHARMACY_SERVICE_URL=http://localhost:8085
