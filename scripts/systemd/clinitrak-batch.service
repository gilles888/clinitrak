[Unit]
Description=CliniTrak Batch Service (port 8089)
After=network.target clinitrak-notification.service clinitrak-pharmacy.service
Wants=clinitrak-notification.service clinitrak-pharmacy.service

[Service]
Type=simple
User=claude-worker
Group=claude-worker

Environment="JAVA_HOME=/home/claude-worker/tools/jdk-21.0.5+11"
Environment="PATH=/home/claude-worker/tools/jdk-21.0.5+11/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ExecStart=/home/claude-worker/tools/jdk-21.0.5+11/bin/java \
  -XX:+UseContainerSupport \
  -XX:MaxRAMPercentage=20.0 \
  -XX:+UseG1GC \
  -Djava.security.egd=file:/dev/./urandom \
  -Dspring.profiles.active=prod \
  -DSERVER_PORT=8089 \
  -DDB_URL=jdbc:postgresql://localhost:5433/clinitrak_batch \
  -DDB_USER=clinitrak \
  -DDB_PASSWORD=PLACEHOLDER_DB_PASSWORD \
  -DJWT_SECRET=PLACEHOLDER_JWT_SECRET \
  -DREDIS_HOST=localhost \
  -DREDIS_PORT=6379 \
  -DCORS_ORIGINS=https://clinitrak.gilmotech.be \
  -DNOTIFICATION_SERVICE_URL=http://localhost:8090 \
  -DPHARMACY_SERVICE_URL=http://localhost:8086 \
  -jar /home/claude-worker/clinitrak/jars/batch-service.jar

Restart=always
RestartSec=15
StandardOutput=append:/var/log/clinitrak/batch-service.log
StandardError=append:/var/log/clinitrak/batch-service.log

[Install]
WantedBy=multi-user.target
